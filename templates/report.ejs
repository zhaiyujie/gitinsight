<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GitInsight — <%= repo %></title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #08090d;
      --surface: rgba(255,255,255,0.04);
      --surface-solid: #111318;
      --surface-hover: rgba(255,255,255,0.07);
      --border: rgba(255,255,255,0.08);
      --border-light: rgba(255,255,255,0.12);
      --text: #f0f0f3;
      --text-dim: #8a8e9a;
      --text-muted: #555866;
      --coral: #ff6b5a;
      --coral-glow: rgba(255,107,90,0.15);
      --amber: #ffb84d;
      --amber-glow: rgba(255,184,77,0.12);
      --sky: #4dc9f6;
      --sky-glow: rgba(77,201,246,0.12);
      --mint: #57d9a3;
      --mint-glow: rgba(87,217,163,0.12);
      --rose: #f78da7;
      --rose-glow: rgba(247,141,167,0.12);
      --indigo: #98a3f7;
      --indigo-glow: rgba(152,163,247,0.12);
      --mono: 'DM Mono', 'Fira Code', monospace;
      --sans: 'Space Grotesk', -apple-system, sans-serif;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      font-family: var(--sans);
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      min-height: 100vh;
      overflow-x: hidden;
    }
    /* Ambient glow blobs */
    body::before {
      content: '';
      position: fixed;
      top: -20%;
      left: -10%;
      width: 50%;
      height: 50%;
      background: radial-gradient(circle, rgba(255,107,90,0.06) 0%, transparent 60%);
      pointer-events: none;
      animation: drift 20s ease-in-out infinite alternate;
    }
    body::after {
      content: '';
      position: fixed;
      bottom: -20%;
      right: -10%;
      width: 50%;
      height: 50%;
      background: radial-gradient(circle, rgba(77,201,246,0.05) 0%, transparent 60%);
      pointer-events: none;
      animation: drift 25s ease-in-out infinite alternate-reverse;
    }
    @keyframes drift {
      0% { transform: translate(0, 0); }
      100% { transform: translate(60px, 40px); }
    }

    .container {
      max-width: 1280px;
      margin: 0 auto;
      padding: 3rem 2rem;
      position: relative;
      z-index: 1;
    }

    /* ── Header ── */
    header {
      text-align: center;
      margin-bottom: 4rem;
      position: relative;
    }
    .header-glow {
      position: absolute;
      top: -80px;
      left: 50%;
      transform: translateX(-50%);
      width: 400px;
      height: 200px;
      background: radial-gradient(ellipse, rgba(255,107,90,0.12) 0%, transparent 70%);
      pointer-events: none;
      filter: blur(40px);
    }
    .logo {
      font-family: var(--mono);
      font-size: 0.75rem;
      font-weight: 500;
      color: var(--coral);
      letter-spacing: 0.25em;
      text-transform: uppercase;
      margin-bottom: 1rem;
      position: relative;
    }
    header h1 {
      font-size: 3.2rem;
      font-weight: 700;
      letter-spacing: -0.04em;
      line-height: 1.1;
      margin-bottom: 0.75rem;
      background: linear-gradient(135deg, #fff 0%, var(--coral) 40%, var(--amber) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      position: relative;
    }
    header .desc {
      color: var(--text-dim);
      font-size: 1.05rem;
      max-width: 520px;
      margin: 0 auto 1.5rem;
    }
    .meta {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 0.6rem;
    }
    .meta-item {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      font-family: var(--mono);
      font-size: 0.78rem;
      color: var(--text-dim);
      padding: 0.35rem 0.85rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 100px;
      backdrop-filter: blur(12px);
      transition: border-color 0.3s;
    }
    .meta-item:hover { border-color: var(--border-light); }

    /* ── Stat Cards ── */
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
      gap: 0.75rem;
      margin-bottom: 3rem;
    }
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 1.4rem 1.5rem;
      position: relative;
      overflow: hidden;
      backdrop-filter: blur(16px);
      transition: transform 0.25s, border-color 0.3s, box-shadow 0.3s;
      animation: cardIn 0.6s cubic-bezier(0.16,1,0.3,1) both;
    }
    .card:hover {
      transform: translateY(-3px);
      border-color: var(--border-light);
    }
    .card:nth-child(1) { animation-delay: 0s; }
    .card:nth-child(2) { animation-delay: 0.06s; }
    .card:nth-child(3) { animation-delay: 0.12s; }
    .card:nth-child(4) { animation-delay: 0.18s; }
    .card:nth-child(5) { animation-delay: 0.24s; }
    .card:nth-child(6) { animation-delay: 0.3s; }
    @keyframes cardIn {
      from { opacity: 0; transform: translateY(20px) scale(0.97); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
    /* Glow orb per card */
    .card::before {
      content: '';
      position: absolute;
      top: -30px;
      right: -30px;
      width: 80px;
      height: 80px;
      border-radius: 50%;
      filter: blur(30px);
      opacity: 0.6;
      pointer-events: none;
    }
    .card:nth-child(1)::before { background: var(--coral); }
    .card:nth-child(2)::before { background: var(--sky); }
    .card:nth-child(3)::before { background: var(--mint); }
    .card:nth-child(4)::before { background: var(--amber); }
    .card:nth-child(5)::before { background: var(--rose); }
    .card:nth-child(6)::before { background: var(--indigo); }
    .card h3 {
      font-family: var(--mono);
      font-size: 0.65rem;
      font-weight: 500;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.12em;
      margin-bottom: 0.6rem;
      position: relative;
    }
    .card .value {
      font-size: 2rem;
      font-weight: 700;
      letter-spacing: -0.03em;
      line-height: 1;
      position: relative;
    }
    .card:nth-child(1) .value { color: var(--coral); }
    .card:nth-child(2) .value { color: var(--sky); }
    .card:nth-child(3) .value { color: var(--mint); }
    .card:nth-child(4) .value { color: var(--amber); }
    .card:nth-child(5) .value { color: var(--rose); }
    .card:nth-child(6) .value { color: var(--indigo); }
    .card .sub {
      font-size: 0.78rem;
      color: var(--text-dim);
      margin-top: 0.4rem;
      font-family: var(--mono);
      position: relative;
    }

    /* ── Sections ── */
    .section {
      margin-bottom: 3rem;
      animation: fadeUp 0.7s cubic-bezier(0.16,1,0.3,1) both;
    }
    .section:nth-of-type(2) { animation-delay: 0.1s; }
    .section:nth-of-type(3) { animation-delay: 0.2s; }
    .section:nth-of-type(4) { animation-delay: 0.3s; }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(24px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .section-header {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1.25rem;
    }
    .section-header .dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--coral);
      box-shadow: 0 0 8px var(--coral);
      flex-shrink: 0;
    }
    .section h2 {
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--text);
      letter-spacing: 0.02em;
      white-space: nowrap;
    }
    .section-header .line {
      flex: 1;
      height: 1px;
      background: linear-gradient(90deg, var(--border-light), transparent);
    }

    /* ── Charts ── */
    .chart-container {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 1.5rem;
      backdrop-filter: blur(16px);
    }
    .chart-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
    }
    @media (max-width: 768px) {
      .chart-row { grid-template-columns: 1fr; }
      header h1 { font-size: 2rem; }
      .container { padding: 2rem 1rem; }
    }
    canvas { max-height: 310px; }

    /* ── Tables ── */
    table {
      width: 100%;
      border-collapse: collapse;
      background: var(--surface);
      border-radius: 14px;
      overflow: hidden;
      border: 1px solid var(--border);
      font-size: 0.88rem;
      backdrop-filter: blur(16px);
    }
    th, td {
      padding: 0.7rem 1.25rem;
      text-align: left;
      border-bottom: 1px solid var(--border);
    }
    th {
      font-family: var(--mono);
      font-size: 0.65rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--text-muted);
      background: rgba(255,107,90,0.04);
    }
    tr:last-child td { border-bottom: none; }
    tr { transition: background 0.2s; }
    tr:hover td { background: var(--surface-hover); }
    td:first-child {
      font-family: var(--mono);
      font-weight: 600;
      color: var(--text-muted);
      width: 40px;
    }
    td:nth-child(2) { font-weight: 600; }
    td:nth-child(3) { font-family: var(--mono); }
    td:nth-child(4) { font-family: var(--mono); color: var(--text-dim); }

    /* ── Badges ── */
    .badge {
      display: inline-block;
      padding: 0.25rem 0.75rem;
      border-radius: 100px;
      font-family: var(--mono);
      font-size: 0.72rem;
      font-weight: 500;
      background: var(--coral-glow);
      color: var(--coral);
      border: 1px solid rgba(255,107,90,0.15);
      transition: transform 0.2s, background 0.2s;
    }
    .badge:hover {
      transform: scale(1.05);
      background: rgba(255,107,90,0.2);
    }

    /* ── Language Bar ── */
    .lang-bar {
      display: flex;
      height: 28px;
      border-radius: 8px;
      overflow: hidden;
      margin-top: 0.75rem;
      box-shadow: 0 2px 12px rgba(0,0,0,0.3);
    }
    .lang-bar div {
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--mono);
      font-size: 0.6rem;
      font-weight: 600;
      color: rgba(255,255,255,0.9);
      min-width: 28px;
      transition: flex 0.4s ease;
    }
    .lang-bar div:hover { flex-grow: 0.3; }
    .lang-legend {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      margin-top: 0.85rem;
    }
    .lang-legend span {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-family: var(--mono);
      font-size: 0.75rem;
      color: var(--text-dim);
    }
    .lang-dot {
      width: 8px;
      height: 8px;
      border-radius: 3px;
      box-shadow: 0 0 4px currentColor;
    }

    /* ── Dep Cards ── */
    .dep-list {
      max-height: 200px;
      overflow-y: auto;
      padding-right: 0.5rem;
    }
    .dep-list::-webkit-scrollbar { width: 4px; }
    .dep-list::-webkit-scrollbar-track { background: transparent; }
    .dep-list::-webkit-scrollbar-thumb { background: var(--border-light); border-radius: 2px; }
    .dep-tag {
      display: inline-block;
      padding: 0.2rem 0.55rem;
      background: var(--surface-hover);
      border: 1px solid var(--border);
      border-radius: 6px;
      margin: 0.2rem;
      font-family: var(--mono);
      font-size: 0.72rem;
      color: var(--text-dim);
      transition: all 0.2s;
    }
    .dep-tag:hover {
      border-color: var(--sky);
      color: var(--sky);
      background: var(--sky-glow);
    }
    code {
      font-family: var(--mono);
      font-size: 0.78rem;
      background: rgba(255,255,255,0.04);
      padding: 0.12rem 0.45rem;
      border-radius: 4px;
      border: 1px solid var(--border);
      color: var(--amber);
    }

    /* ── Footer ── */
    .footer {
      text-align: center;
      color: var(--text-muted);
      font-family: var(--mono);
      font-size: 0.72rem;
      margin-top: 4rem;
      padding-top: 2rem;
      border-top: 1px solid var(--border);
    }
    .footer strong {
      background: linear-gradient(90deg, var(--coral), var(--amber));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .labels-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <div class="header-glow"></div>
      <div class="logo">GitInsight</div>
      <h1><%= repo %></h1>
      <p class="desc"><%= analysis.code.description || 'Repository health report' %></p>
      <div class="meta">
        <div class="meta-item">&#11088; <%= analysis.code.stars.toLocaleString() %> stars</div>
        <div class="meta-item">&#128260; <%= analysis.code.forks.toLocaleString() %> forks</div>
        <div class="meta-item">&#128230; <%= (analysis.code.repoSize / 1024).toFixed(1) %> MB</div>
        <div class="meta-item">&#128197; <%= generatedAt %></div>
      </div>
    </header>

    <div class="grid">
      <div class="card">
        <h3>Total Commits</h3>
        <div class="value"><%= analysis.commits.totalCommits.toLocaleString() %></div>
        <div class="sub"><%= analysis.commits.activeDays %> active days</div>
      </div>
      <div class="card">
        <h3>Contributors</h3>
        <div class="value"><%= analysis.commits.topContributors.length %></div>
        <div class="sub">Top: <%= analysis.commits.topContributors[0]?.name || 'N/A' %></div>
      </div>
      <div class="card">
        <h3>Open Issues</h3>
        <div class="value"><%= analysis.issues.openIssues %></div>
        <div class="sub"><%= analysis.issues.closeRate %>% close rate</div>
      </div>
      <div class="card">
        <h3>Pull Requests</h3>
        <div class="value"><%= analysis.prs.totalPRs %></div>
        <div class="sub"><%= analysis.prs.mergeRate %>% merge rate</div>
      </div>
      <div class="card">
        <h3>Branches</h3>
        <div class="value"><%= analysis.code.branchCount %></div>
        <div class="sub">Default: <%= analysis.code.defaultBranch %></div>
      </div>
      <div class="card">
        <h3>Dependencies</h3>
        <div class="value"><%= analysis.dependencies.dependencyCount %></div>
        <div class="sub"><%= analysis.dependencies.devDependencyCount %> dev deps</div>
      </div>
    </div>

    <div class="section">
      <div class="section-header">
        <div class="dot"></div>
        <h2>Commit Activity</h2>
        <div class="line"></div>
      </div>
      <div class="chart-row">
        <div class="chart-container"><canvas id="commitTrend"></canvas></div>
        <div class="chart-container"><canvas id="contributors"></canvas></div>
      </div>
    </div>

    <div class="section">
      <div class="section-header">
        <div class="dot" style="background:var(--amber);box-shadow:0 0 8px var(--amber)"></div>
        <h2>Languages</h2>
        <div class="line"></div>
      </div>
      <div class="chart-row">
        <div class="chart-container"><canvas id="languages"></canvas></div>
        <div class="card" style="display:flex;flex-direction:column;justify-content:center">
          <h3>Distribution</h3>
          <% const langColors = ['#ff6b5a','#ffb84d','#4dc9f6','#57d9a3','#f78da7','#98a3f7','#ff9f43','#54a0ff','#5f27cd','#01a3a4']; %>
          <div class="lang-bar">
            <% analysis.code.languages.slice(0, 10).forEach(function(lang, i) { %>
              <div style="width:<%= lang.percentage %>%; background:<%= langColors[i] || '#555' %>"><%= lang.percentage >= 5 ? lang.percentage + '%' : '' %></div>
            <% }); %>
          </div>
          <div class="lang-legend">
            <% analysis.code.languages.slice(0, 10).forEach(function(lang, i) { %>
              <span><span class="lang-dot" style="background:<%= langColors[i] || '#555' %>;color:<%= langColors[i] || '#555' %>"></span><%= lang.name %> &middot; <%= lang.percentage %>%</span>
            <% }); %>
          </div>
        </div>
      </div>
    </div>

    <div class="section">
      <div class="section-header">
        <div class="dot" style="background:var(--mint);box-shadow:0 0 8px var(--mint)"></div>
        <h2>Issues & Pull Requests</h2>
        <div class="line"></div>
      </div>
      <div class="chart-row">
        <div class="chart-container"><canvas id="issueTrend"></canvas></div>
        <div class="chart-container"><canvas id="prTrend"></canvas></div>
      </div>
      <div class="grid" style="margin-top:0.75rem">
        <div class="card">
          <h3>Avg Issue Close Time</h3>
          <div class="value"><%= analysis.issues.avgCloseDays %> <span style="font-size:0.85rem;font-weight:400;color:var(--text-dim)">days</span></div>
          <div class="sub"><%= analysis.issues.staleIssues %> stale (&gt;30d)</div>
        </div>
        <div class="card">
          <h3>Avg PR Merge Time</h3>
          <div class="value"><%= analysis.prs.avgMergeDays %> <span style="font-size:0.85rem;font-weight:400;color:var(--text-dim)">days</span></div>
          <div class="sub"><%= analysis.prs.mergedPRs %> merged total</div>
        </div>
      </div>
    </div>

    <div class="section">
      <div class="section-header">
        <div class="dot" style="background:var(--sky);box-shadow:0 0 8px var(--sky)"></div>
        <h2>Top Contributors</h2>
        <div class="line"></div>
      </div>
      <table>
        <thead><tr><th>#</th><th>Name</th><th>Commits</th><th>Share</th></tr></thead>
        <tbody>
          <% analysis.commits.topContributors.forEach(function(c, i) { %>
          <tr>
            <td><%= i + 1 %></td>
            <td><%= c.name %></td>
            <td><%= c.commits.toLocaleString() %></td>
            <td><%= (c.commits / analysis.commits.totalCommits * 100).toFixed(1) %>%</td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <% if (analysis.issues.topLabels.length > 0) { %>
    <div class="section">
      <div class="section-header">
        <div class="dot" style="background:var(--rose);box-shadow:0 0 8px var(--rose)"></div>
        <h2>Issue Labels</h2>
        <div class="line"></div>
      </div>
      <div class="labels-grid">
        <% analysis.issues.topLabels.forEach(function(l) { %>
          <span class="badge"><%= l.name %> &times; <%= l.count %></span>
        <% }); %>
      </div>
    </div>
    <% } %>

    <% if (analysis.dependencies.hasPackageJson) { %>
    <div class="section">
      <div class="section-header">
        <div class="dot" style="background:var(--indigo);box-shadow:0 0 8px var(--indigo)"></div>
        <h2>Dependencies</h2>
        <div class="line"></div>
      </div>
      <div class="chart-row">
        <div class="card">
          <h3>Production (<%= analysis.dependencies.dependencyCount %>)</h3>
          <div class="dep-list">
            <% analysis.dependencies.dependencies.forEach(function(d) { %>
              <span class="dep-tag"><%= d %></span>
            <% }); %>
          </div>
        </div>
        <div class="card">
          <h3>Dev (<%= analysis.dependencies.devDependencyCount %>)</h3>
          <div class="dep-list">
            <% analysis.dependencies.devDependencies.forEach(function(d) { %>
              <span class="dep-tag"><%= d %></span>
            <% }); %>
          </div>
        </div>
      </div>
      <% if (analysis.dependencies.scripts.length > 0) { %>
      <div class="card" style="margin-top:0.75rem">
        <h3>NPM Scripts</h3>
        <table style="margin-top:0.5rem">
          <thead><tr><th style="width:140px">Script</th><th>Command</th></tr></thead>
          <tbody>
            <% analysis.dependencies.scripts.forEach(function(s) { %>
            <tr><td><code><%= s.name %></code></td><td><code><%= s.command %></code></td></tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>
    <% } %>

    <div class="footer">
      Generated by <strong>GitInsight</strong> &mdash; <%= generatedAt %>
    </div>
  </div>

  <script>
    const charts = <%- charts %>;
    const fontFamily = "'DM Mono', 'Fira Code', monospace";
    const gridColor = 'rgba(255,255,255,0.04)';
    const tickColor = '#555866';

    const palette = ['#ff6b5a','#ffb84d','#4dc9f6','#57d9a3','#f78da7','#98a3f7','#ff9f43','#54a0ff'];

    const defaults = {
      responsive: true,
      animation: { duration: 1000, easing: 'easeOutQuart' },
      plugins: {
        legend: { labels: { color: '#8a8e9a', font: { family: fontFamily, size: 11 }, boxWidth: 12, padding: 16 } },
        tooltip: {
          backgroundColor: 'rgba(17,19,24,0.95)',
          titleColor: '#f0f0f3',
          bodyColor: '#8a8e9a',
          borderColor: 'rgba(255,255,255,0.1)',
          borderWidth: 1,
          titleFont: { family: fontFamily, weight: '600' },
          bodyFont: { family: fontFamily },
          padding: 12,
          cornerRadius: 10,
          displayColors: true,
          caretSize: 0,
        },
      },
      scales: {
        x: {
          ticks: { color: tickColor, font: { family: fontFamily, size: 10 }, maxRotation: 45 },
          grid: { color: gridColor, lineWidth: 1 },
          border: { display: false },
        },
        y: {
          ticks: { color: tickColor, font: { family: fontFamily, size: 10 } },
          grid: { color: gridColor, lineWidth: 1 },
          border: { display: false },
        },
      },
    };
    const pieDefaults = {
      responsive: true,
      animation: { duration: 1000, easing: 'easeOutQuart' },
      cutout: '65%',
      plugins: {
        legend: {
          position: 'right',
          labels: { color: '#8a8e9a', font: { family: fontFamily, size: 11 }, boxWidth: 10, padding: 14 },
        },
        tooltip: {
          backgroundColor: 'rgba(17,19,24,0.95)',
          titleColor: '#f0f0f3',
          bodyColor: '#8a8e9a',
          borderColor: 'rgba(255,255,255,0.1)',
          borderWidth: 1,
          titleFont: { family: fontFamily, weight: '600' },
          bodyFont: { family: fontFamily },
          padding: 12,
          cornerRadius: 10,
          caretSize: 0,
        },
      },
    };

    Object.entries(charts).forEach(([id, config]) => {
      const ctx = document.getElementById(id);
      if (!ctx) return;
      if (config.type === 'doughnut' || config.type === 'pie') {
        if (config.data && config.data.datasets && config.data.datasets[0]) {
          config.data.datasets[0].backgroundColor = palette;
        }
      }
      if (config.type === 'line' && config.data && config.data.datasets) {
        config.data.datasets.forEach(function(ds) {
          if (!ds.borderColor || ds.borderColor === '#3b82f6') ds.borderColor = '#ff6b5a';
          if (!ds.backgroundColor || ds.backgroundColor === 'rgba(59, 130, 246, 0.1)') {
            ds.backgroundColor = 'rgba(255, 107, 90, 0.08)';
          }
          ds.borderWidth = 2;
          ds.pointRadius = 3;
          ds.pointBackgroundColor = '#ff6b5a';
          ds.pointBorderColor = 'transparent';
        });
      }
      if (config.type === 'bar' && config.data && config.data.datasets) {
        var barColors = ['#ff6b5a','#ffb84d','#4dc9f6','#57d9a3','#f78da7','#98a3f7'];
        config.data.datasets.forEach(function(ds, i) {
          if (!ds.backgroundColor || ['#ef4444','#10b981','#f59e0b','#8b5cf6'].indexOf(ds.backgroundColor) !== -1) {
            ds.backgroundColor = barColors[i % barColors.length];
          }
          ds.borderRadius = 6;
          ds.borderSkipped = false;
        });
      }
      const opts = (config.type === 'doughnut' || config.type === 'pie') ? pieDefaults : defaults;
      new Chart(ctx, { ...config, options: { ...opts, ...config.options } });
    });
  </script>
</body>
</html>
